#!/bin/bash

function access_denied() {
	echo "Access Denied: $1"
	zenity --timeout=42 --error --title="Forbidden" --text="Access Denied\n\n$1" || true
	exit 1
}

# Helper: check if user is in whitelist
function _is_user_authorized() {
	local -n users_array=$1
	for user in "${users_array[@]}"; do
		if [ "$USER" == "$user" ]; then
			return 0
		fi
	done
	return 1
}

# Helper: check if user is in blacklist
function _is_user_blacklisted() {
	local -n users_array=$1
	for user in "${users_array[@]}"; do
		if [ "$USER" == "$user" ]; then
			return 0
		fi
	done
	return 1
}

function default_mode_authorization() {
	local blacklisted_users=(
			"biche"
		)

	if _is_user_blacklisted blacklisted_users; then
		access_denied "You are not authorized to log in on this workstation."
	fi
}

function exam_mode_authorization() {
	if [ "$USER" != "exam" ]; then
		access_denied "This workstation is reserved for Exam sessions."
	fi
}

function event_mode_authorization() {
	if [ "$USER" != "event" ]; then
		access_denied "This workstation is reserved for Event sessions."
	fi
}

function maintenance_mode_authorization() {
	local authorized_users=(
			"cameo"
			"pillo"
			"zippy"
		)

	if ! _is_user_authorized authorized_users; then
		access_denied "This workstation is under maintenance."
	fi
}

function disco_mode_authorization() {
	local authorized_users=(
			"cameo"
			"pillo"
			"zippy"
		)

	if ! _is_user_authorized authorized_users; then
		access_denied "This workstation is reserved for Discovery Piscine participants."
	fi
}

function piscine_mode_authorization() {
	if ! /usr/share/42/scripts/is-pisciner.sh "$USER" >/dev/null; then
		access_denied "This workstation is reserved for Piscine participants."
	fi
}
