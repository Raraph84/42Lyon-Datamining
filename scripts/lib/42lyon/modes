#!/bin/bash

function access_denied() {
	echo "Access Denied: $1"
	zenity --timeout=42 --error --title="Forbidden" --text="Access Denied\n\n$1" || true
	exit 1
}

# Helper: check if user is in whitelist
function _is_user_authorized() {
	local -n users_array=$1
	for user in "${users_array[@]}"; do
		if [ "$USER" == "$user" ]; then
			return 0
		fi
	done
	return 1
}

# Helper: check if user is in blacklist
function _is_user_blacklisted() {
	local -n users_array=$1
	for user in "${users_array[@]}"; do
		if [ "$USER" == "$user" ]; then
			return 0
		fi
	done
	return 1
}

